# Copy to .env (or set in your hosting dashboard). In production, BASE_URL, ADMIN_PASSWORD and the Stripe keys are required.
NODE_ENV=production
PORT=3000
BASE_URL=https://film-archives.com

# Password for the seller dashboard (/admin). Use a long random string.
ADMIN_PASSWORD=change-me

# Signs login cookies. Generated automatically into DATA_DIR if left unset.
# SESSION_SECRET=

# Stripe (https://dashboard.stripe.com/apikeys). Without a key, purchases are disabled in production
# and run in no-payment demo mode in development.
STRIPE_SECRET_KEY=sk_live_...
# Webhook endpoint: https://film-archives.com/webhooks/stripe  (event: checkout.session.completed)
STRIPE_WEBHOOK_SECRET=whsec_...

CURRENCY=eur

# Where the database, masters, previews and thumbnails are stored. Put this on a persistent, backed-up disk.
DATA_DIR=./data
MAX_UPLOAD_MB=4096
DOWNLOAD_TTL_HOURS=72
MAX_DOWNLOADS=5
