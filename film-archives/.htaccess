# Film Archives — route every request through index.php.
DirectoryIndex index.php
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Send every visitor to HTTPS. The extra conditions avoid a redirect loop
  # when SSL is handled by a proxy in front of Apache.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{SERVER_PORT} !=443
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=302,L]

  RewriteRule ^(app|data)(/|$) - [F,L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ index.php [E=FA_PRETTY:1,L]
</IfModule>

# Allow large uploads where the host permits overriding PHP limits here.
<IfModule mod_php.c>
  php_value upload_max_filesize 1900M
  php_value post_max_size 1900M
  php_value max_execution_time 600
  php_value max_input_time 600
</IfModule>
<IfModule mod_php8.c>
  php_value upload_max_filesize 1900M
  php_value post_max_size 1900M
  php_value max_execution_time 600
  php_value max_input_time 600
</IfModule>

<FilesMatch "\.(sqlite|db|log|ini)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Deny from all
  </IfModule>
</FilesMatch>
